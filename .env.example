# Copy to .env and adjust. Every value has a local default; nothing here is required.

# Any OpenAI-compatible endpoint. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_API_KEY=ollama
# OpenAI:        LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-5.1   LLM_API_KEY=<your key>
# Azure OpenAI:  LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1   LLM_MODEL=<deployment>   LLM_API_KEY=<your key>

# Redis database 5 keeps the demo apart from anything else on the same Redis.
REDIS_URL=redis://localhost:6379/5

# Set to use Qdrant instead of the local NumPy index (scripts/run_all.py --qdrant sets it for you).
# QDRANT_URL=http://localhost:6333

# Signs demo JWTs and download links. Change it for anything beyond a local demo.
JWT_SECRET=local-demo-secret-change-me

# Demo switch: make the document-graph write fail, to show publish rollback.
# DOCS_SIMULATE_GRAPH_FAILURE=1
